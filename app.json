{
  "expo": {
    "name": "Bookflow",
    "slug": "Bookflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Bookflow apps icon-fullbleed.png",
    "scheme": "bookflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akkmal.Bookflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Bookflow Andoid Icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.akkmal.Bookflow"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Bookflow apps icon-fullbleed.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bookflow-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FB",
          "android": {
            "image": "./assets/images/Bookflow Andoid Icon.png",
            "imageWidth": 160,
            "resizeMode": "contain",
            "backgroundColor": "#F5F7FB"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#006B52"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

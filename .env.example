# ---------------------------------------------------------------------------
# Build variant
# ---------------------------------------------------------------------------
# Selects the bundle identifier, app name and signing setup in app.config.js.
# EAS sets this per build profile via `env` in eas.json, so you normally leave it
# unset — local development then falls back to `development` (my.bookflow.app.dev).
# Set it only to preview a store build's resolved config locally:
#   APP_VARIANT=production npx expo config --type public
# APP_VARIANT=development

# ---------------------------------------------------------------------------
# Client-safe values. Everything EXPO_PUBLIC_* is inlined into the app bundle and
# is readable by anyone who downloads it. Never put a secret behind this prefix.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# PostHog public project settings
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# RevenueCat — DEVELOPMENT (Test Store)
# Simulated purchases, no Apple Developer account needed. Development builds only:
# resolveRevenueCatConfig() refuses a `test_` key in any release build.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_replace_me

# RevenueCat — PRODUCTION public SDK keys (Project Settings > API keys).
# Apple keys start with `appl_`, Google Play keys with `goog_`. A release build
# (preview or production) disables purchasing entirely until the `appl_` key is set.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_me

# ---------------------------------------------------------------------------
# Build-time only. NOT inlined into the app, must never gain an EXPO_PUBLIC_ prefix.
# On EAS, store these as Secret-type environment variables, not in this file.
# ---------------------------------------------------------------------------
# Uploads source maps to Sentry during an EAS build.
SENTRY_AUTH_TOKEN=

# Server-side Clerk key. Local tooling only — never referenced by app code.
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Where these live for a cloud build
# ---------------------------------------------------------------------------
# `.env.local` is gitignored, so EAS Build never sees it. Each EXPO_PUBLIC_ value
# above must also exist in the matching EAS environment (development / preview /
# production) under Project settings > Environment variables, or the cloud build
# will inline an empty string.

# Optional override; defaults to the free https://bookflow.expo.app domain.
# EXPO_PUBLIC_INVOICE_WEB_URL=https://bookflow.expo.app
